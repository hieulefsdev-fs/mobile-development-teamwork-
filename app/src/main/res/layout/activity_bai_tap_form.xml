<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:scrollbars="vertical" android:fadeScrollbars="false">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
    <Button
        android:id="@+id/tro_ve"
        style="?attr/borderlessButtonStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="‹ Trở về" />
    <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="24sp" android:textStyle="bold" android:paddingBottom="12dp" />
    <EditText android:id="@+id/ten" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Tên bài tập (bắt buộc)" android:inputType="textCapSentences" android:singleLine="true" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:labelFor="@id/mon"
        android:text="Môn học" />
    <Button android:id="@+id/mon" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="@string/chon_mon_hoc" />
    <Button
        android:id="@+id/them_mon"
        style="?attr/borderlessButtonStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Thêm môn học" />
    <Button android:id="@+id/doi_ten_mon" style="?attr/borderlessButtonStyle"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Đổi tên môn đã chọn" />
    <LinearLayout android:id="@+id/danh_sach_mon"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:visibility="gone" />
    <LinearLayout android:id="@+id/khung_them_mon"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:visibility="gone">
        <EditText android:id="@+id/ten_mon_moi" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="Tên môn học"
            android:inputType="textCapSentences" />
        <Button android:id="@+id/luu_mon_moi" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Lưu môn học" />
        <Button android:id="@+id/huy_them_mon" style="?attr/borderlessButtonStyle"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Hủy" />
    </LinearLayout>
    <EditText android:id="@+id/mo_ta" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Mô tả (tùy chọn)" android:inputType="textCapSentences|textMultiLine" android:minLines="3" android:gravity="top" />
    <Button android:id="@+id/chon_ngay" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Chọn hạn nộp" />
    <LinearLayout
        android:id="@+id/khung_lich"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Ngày / Tháng / Năm · Giờ / Phút (24 giờ)" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal">
            <EditText
                android:id="@+id/han_ngay"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:contentDescription="Ngày"
                android:hint="Ngày"
                android:inputType="number"
                android:maxLength="2"
                android:gravity="center"
                android:singleLine="true"
                android:textSize="14sp" />
            <EditText
                android:id="@+id/han_thang"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:contentDescription="Tháng"
                android:hint="Tháng"
                android:inputType="number"
                android:maxLength="2"
                android:gravity="center"
                android:singleLine="true"
                android:textSize="14sp" />
            <EditText
                android:id="@+id/han_nam"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.25"
                android:contentDescription="Năm"
                android:hint="Năm"
                android:inputType="number"
                android:maxLength="4"
                android:gravity="center"
                android:singleLine="true"
                android:textSize="14sp" />
            <EditText
                android:id="@+id/han_gio"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:contentDescription="Giờ"
                android:hint="Giờ"
                android:inputType="number"
                android:maxLength="2"
                android:gravity="center"
                android:singleLine="true"
                android:textSize="14sp" />
            <EditText
                android:id="@+id/han_phut"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:contentDescription="Phút"
                android:hint="Phút"
                android:inputType="number"
                android:maxLength="2"
                android:gravity="center"
                android:singleLine="true"
                android:textSize="14sp" />
        </LinearLayout>
        <Button android:id="@+id/xac_nhan_ngay" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Xác nhận ngày và giờ" />
    </LinearLayout>
    <TextView
        android:id="@+id/loi_bieu_mau"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityLiveRegion="polite"
        android:visibility="gone" />
    <Button android:id="@+id/luu" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Lưu bài tập" />
</LinearLayout>
</ScrollView>

