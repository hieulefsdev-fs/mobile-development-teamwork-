<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp">
    <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Bài tập của tôi" android:textSize="30sp" android:textColor="?attr/colorOnSurface" android:textStyle="bold" android:paddingBottom="12dp" />
    <Button android:id="@+id/mon_loc" style="?attr/borderlessButtonStyle"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="48dp" android:gravity="start|center_vertical"
        android:text="Tất cả môn học" />
    <ScrollView android:layout_width="match_parent" android:layout_height="144dp"
        android:fillViewport="true" android:id="@+id/khung_loc_mon" android:visibility="gone">
        <RadioGroup android:id="@+id/cac_mon" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" />
    </ScrollView>
    <com.google.android.material.tabs.TabLayout android:id="@+id/tabs" android:layout_width="match_parent" android:layout_height="wrap_content"  />
    <TextView android:id="@+id/trong" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Chưa có bài tập trong danh sách này" android:gravity="center" android:padding="24dp" android:visibility="gone" />
    <ListView android:id="@+id/danh_sach" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:paddingTop="12dp" android:clipToPadding="false" android:divider="@android:color/transparent" android:dividerHeight="8dp" />
    <Button android:id="@+id/them" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:text="＋ Thêm bài tập" />
</LinearLayout>

